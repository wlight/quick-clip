<ui:FluentWindow x:Class="QuickClip.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:QuickClip.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
                 Title="QuickClip"
                 Width="420" Height="620"
                 MinWidth="320" MinHeight="300"
                 WindowStartupLocation="Manual"
                 ShowInTaskbar="False"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource Theme.Panel}"
                 BorderBrush="{DynamicResource Theme.Border}"
                 BorderThickness="1"
                 KeyDown="OnWindowKeyDown"
                 PreviewKeyDown="OnWindowPreviewKeyDown"
                 Closing="OnWindowClosing"
                 Activated="OnWindowActivated"
                 Deactivated="OnWindowDeactivated">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <!--
      Win11 剪贴板历史形态的浮动面板：无标题栏，Win+V 时在光标处浮出，
      结构为「搜索行 + 条目列表 + 命令栏」，失焦即隐（图钉置顶时除外）。
    -->
    <Grid x:Name="RootGrid" Background="{DynamicResource Theme.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：搜索 + 类型筛选 + 图钉（保持打开） -->
        <Grid Grid.Row="0" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
              搜索框外框由这一层 Border 单独绘制：内层 ui:TextBox 去底色去边框后只负责输入，
              放大镜与文本框按列排布（而非绝对定位叠放），占位文字与描边不会互相错位。
              宽度固定 200 并左对齐，右侧留白——搜索框不铺满整行；外层 Grid 负责裁剪，
              窗口被压到很窄时也不会顶到筛选 / 置顶。
            -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Border Width="200"
                        HorizontalAlignment="Left"
                        Height="34"
                        CornerRadius="6"
                        ClipToBounds="True"
                        Background="{DynamicResource Theme.Search}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Search24"
                                       FontSize="14"
                                       Margin="8,0,6,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource Theme.TextMuted}" />

                        <ui:TextBox x:Name="SearchBox"
                                    Grid.Column="1"
                                    Padding="0"
                                    VerticalContentAlignment="Center"
                                    PlaceholderText="搜索剪贴板内容"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Theme.Text}" />
                    </Grid>
                </Border>
            </Grid>

            <!--
              宽度 86 是给 WPF-UI 的 ComboBox 模板留出「左内边距 + 文字 + 右侧箭头」三段的余量：
              74 时「全部」会贴到箭头上，看起来像被遮挡。右侧还有整段留白，多这 12px 不影响搜索框。
            -->
            <ComboBox Grid.Column="1"
                      Width="86"
                      Height="34"
                      Padding="10,0"
                      Margin="6,0,0,0"
                      VerticalContentAlignment="Center"
                      SelectedIndex="{Binding FilterIndex}"
                      Background="{DynamicResource Theme.Search}"
                      BorderBrush="{DynamicResource Theme.Border}"
                      Foreground="{DynamicResource Theme.Text}">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="文本" />
                <ComboBoxItem Content="图片" />
                <ComboBoxItem Content="链接" />
            </ComboBox>

            <ui:Button x:Name="PinWindowButton"
                       Grid.Column="2"
                       Width="34"
                       Height="34"
                       Padding="0"
                       Margin="6,0,0,0"
                       Appearance="Transparent"
                       CornerRadius="6"
                       ToolTip="窗口置顶（前端固定），失焦不隐藏"
                       Click="OnPinWindowClicked">
                <ui:SymbolIcon x:Name="PinWindowIcon"
                               Symbol="Pin24"
                               FontSize="15"
                               Foreground="{DynamicResource Theme.TextSecondary}" />
            </ui:Button>
        </Grid>

        <!-- 条目列表（仿 Win11 剪贴板历史：单列宽卡片）+ 空状态 -->
        <Grid Grid.Row="1" Margin="6,0,6,0">
        <ListBox x:Name="ItemList"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6,2,6,2"
                 Visibility="{Binding ListVisibility}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 SelectionMode="Single"
                 MouseLeftButtonDown="OnItemListMouseLeftButtonDown"
                 MouseDoubleClick="OnItemListDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                      仿 Win11 剪贴板历史：单列宽卡片自上而下堆叠。
                      StackPanel 不虚拟化，条目上限见 MainViewModel.MaxRenderedItems
                      （超出由搜索/筛选定位），避免一次解码过多缩略图。
                    -->
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!-- 保留 IsSelected 供卡片 DataTrigger 绑定 -->
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ClipboardItemViewModel}">
                    <!--
                      卡片（仿 Win11 剪贴板历史）：整行宽，内容区（图片等比限高 / 文本 3 行截断）
                      + 元信息行；悬停露出二维码、OCR 与「…」菜单，选中走强调色描边，置顶走金色描边。
                    -->
                    <Border x:Name="ItemCard"
                            Margin="2,2"
                            Padding="12,9"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            MouseEnter="OnCardMouseEnter"
                            MouseLeave="OnCardMouseLeave">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Theme.Card}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <!-- 置顶（未选中）：金色描边 -->
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Pin}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                    <!-- 悬停（未选中）：专用悬停底 + 更强描边 -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardHover}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
                                    </MultiDataTrigger>
                                    <!-- 选中：强调色描边 + 选中底 -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardSelected}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 内容区：图片等比缩放（限高 96，整图可见）/ 文本三行截断 -->
                            <Border Grid.Row="0"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Left"
                                    Background="#0DFFFFFF"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform"
                                       MaxHeight="96"
                                       SnapsToDevicePixels="True" />
                            </Border>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding PreviewText}"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       LineHeight="19"
                                       MaxHeight="57"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding IsTextual, Converter={StaticResource BoolToVis}}" />

                            <!-- 元信息行：序号 + 类型 + 时间（动作按钮是右上角浮层，不挤压此行） -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="14"
                                            Height="14"
                                            Margin="0,0,5,0"
                                            CornerRadius="4"
                                            Background="{DynamicResource Theme.Badge}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IndexText}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ui:SymbolIcon Symbol="{Binding TypeIcon}"
                                                   FontSize="11"
                                                   Margin="0,0,4,0"
                                                   Foreground="{DynamicResource Theme.TextMuted}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TypeLabel}"
                                               Foreground="{DynamicResource Theme.TextSecondary}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text=" · "
                                               Foreground="{DynamicResource Theme.TextMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TimeText}"
                                               Foreground="{DynamicResource Theme.TextSecondary}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                            </Grid>

                            <!--
                              悬停动作浮层（仿 Win11 卡片右上角）：置顶标识 + 二维码 / OCR / 「…」菜单，
                              底色跟随卡片状态，浮在文字上时不会糊成一团。
                            -->
                            <Border Grid.RowSpan="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    CornerRadius="6"
                                    Padding="4,2"
                                    Margin="0,-5,-5,0"
                                    Background="{Binding Background, ElementName=ItemCard}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ItemCard}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOcrBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Pin24"
                                                   FontSize="11"
                                                   Margin="0,0,4,0"
                                                   Foreground="{DynamicResource Theme.Pin}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button Appearance="Transparent"
                                               Padding="3"
                                               Margin="1,0"
                                               CornerRadius="5"
                                               ToolTip="{Binding QrActionToolTip}"
                                               Visibility="{Binding ShowQrAction, Converter={StaticResource BoolToVis}}"
                                               Click="OnQrClicked"
                                               MouseEnter="OnQrButtonMouseEnter"
                                               MouseLeave="OnQrButtonMouseLeave">
                                        <ui:SymbolIcon Symbol="{Binding QrActionIcon}" FontSize="13" />
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent"
                                               Padding="3"
                                               Margin="1,0"
                                               CornerRadius="5"
                                               ToolTip="{Binding OcrToolTip}"
                                               IsEnabled="{Binding IsOcrEnabled}"
                                               Click="OnOcrClicked">
                                        <ui:SymbolIcon Symbol="ScanText24" FontSize="13" />
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent"
                                               Padding="3"
                                               Margin="1,0"
                                               CornerRadius="5"
                                               ToolTip="更多操作"
                                               Click="OnItemMenuClicked">
                                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="13" />
                                    </ui:Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="24,0"
                    Visibility="{Binding EmptyVisibility}">
            <ui:SymbolIcon Symbol="ClipboardTextLtr24"
                           FontSize="40"
                           Foreground="{DynamicResource Theme.TextMuted}"
                           HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyHint}"
                       Margin="0,16,0,0"
                       Foreground="{DynamicResource Theme.TextSecondary}"
                       FontSize="13.5"
                       LineHeight="22"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="280" />
        </StackPanel>
        </Grid>

        <!-- 底部命令栏：状态 / 截断提示 / 帮助 · 清空 · 设置 -->
        <Border Grid.Row="2"
                Margin="12,6,12,10"
                Padding="10,5"
                CornerRadius="6"
                Background="{DynamicResource Theme.Card}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Text="{Binding StatusText}" />
                    <TextBlock Foreground="{DynamicResource Theme.TextMuted}"
                               FontSize="11"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding TruncatedHint}"
                               Visibility="{Binding TruncatedVisibility}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="HelpTipButton"
                               Appearance="Transparent"
                               Padding="4,2"
                               CornerRadius="6"
                               ToolTip="快捷键提示">
                        <ui:SymbolIcon Symbol="QuestionCircle24"
                                       FontSize="15"
                                       Foreground="{DynamicResource Theme.TextSecondary}" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               Padding="4,2"
                               Margin="2,0,0,0"
                               CornerRadius="6"
                               ToolTip="清空列表（删除全部非置顶，置顶保留）"
                               Click="OnClearListClicked">
                        <ui:SymbolIcon Symbol="Delete24"
                                       FontSize="15"
                                       Foreground="{DynamicResource Theme.TextSecondary}" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               Padding="4,2"
                               Margin="2,0,0,0"
                               CornerRadius="6"
                               ToolTip="设置…"
                               Click="OnSettingsClicked">
                        <ui:SymbolIcon Symbol="Settings24"
                                       FontSize="15"
                                       Foreground="{DynamicResource Theme.Text}" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 条目「…」菜单：单实例 Popup（DataContext = 当前条目），动作按钮复用条目处理器 -->
        <Popup x:Name="ItemMenuPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Placement="Bottom"
               Closed="OnItemMenuClosed">
            <Border Margin="6"
                    Padding="4"
                    CornerRadius="8"
                    Background="{DynamicResource Theme.Card}"
                    BorderBrush="{DynamicResource Theme.BorderStrong}"
                    BorderThickness="1"
                    ButtonBase.Click="OnItemMenuActionClicked">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.38" Color="Black" />
                </Border.Effect>
                <StackPanel MinWidth="184">
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Padding="10,7"
                               CornerRadius="6"
                               Click="OnCopyClicked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="复制" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Padding="10,7"
                               CornerRadius="6"
                               Click="OnPasteFromMenuClicked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ClipboardTextLtr24" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="粘贴到当前窗口" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Padding="10,7"
                               CornerRadius="6"
                               Click="OnPinClicked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pin24" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="固定" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Text" Value="取消固定" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Padding="10,7"
                               CornerRadius="6"
                               Visibility="{Binding ShowQrAction, Converter={StaticResource BoolToVis}}"
                               Click="OnQrClicked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="QrCode24" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="二维码…" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Padding="10,7"
                               CornerRadius="6"
                               Click="OnOcrClicked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ScanText24" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="OCR 识别文字…" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Padding="10,7"
                               CornerRadius="6"
                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                               Click="OnSaveImageClicked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="另存为图片…" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Padding="10,7"
                               CornerRadius="6"
                               Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"
                               Click="OnCopyFilePathClicked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="复制文件全路径" />
                        </StackPanel>
                    </ui:Button>
                    <Border Height="1" Margin="6,4" Background="{DynamicResource Theme.Border}" />
                    <ui:Button Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Padding="10,7"
                               CornerRadius="6"
                               Click="OnDeleteClicked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="删除" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 悬浮预览：颜色由 ApplyHoverPreviewTheme 按当前主题刷（Popup 本地值需跟主题刷新） -->
        <Popup x:Name="PreviewPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               Focusable="False">
            <Grid x:Name="PreviewRoot"
                  MouseEnter="OnPreviewMouseEnter"
                  MouseLeave="OnPreviewMouseLeave">
                <Border x:Name="PreviewBorder"
                        CornerRadius="12"
                        BorderThickness="1"
                        Padding="16,12"
                        MaxWidth="480"
                        MinWidth="160">
                    <Border.Effect>
                        <DropShadowEffect x:Name="PreviewShadow"
                                          BlurRadius="24"
                                          ShadowDepth="3"
                                          Direction="270"
                                          Opacity="0.45"
                                          Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon x:Name="PreviewTypeIcon"
                                           Symbol="{Binding TypeIcon}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaType"
                                       Text="{Binding TypeLabel}"
                                       FontSize="11"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaDot1"
                                       Text=" · "
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaTime"
                                       Text="{Binding TimeText}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaDot2"
                                       Text=" · "
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaSize"
                                       Text="{Binding SizeText}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- 普通悬停：图片缩略 / 文本全文 -->
                        <Image x:Name="PreviewHoverImage"
                               Source="{Binding HoverThumbnail}"
                               MaxWidth="440"
                               MaxHeight="300"
                               Stretch="Uniform"
                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                        <Border x:Name="PreviewQrDecodePanel"
                                Margin="0,12,0,0"
                                Padding="10,8,10,8"
                                CornerRadius="8"
                                Visibility="Collapsed">
                            <Grid>
                                <Border x:Name="PreviewQrDecodeBar"
                                        Width="3"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch" />
                                <StackPanel Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="PreviewQrDecodeIcon"
                                                       Symbol="ScanQrCode24"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                        <TextBlock x:Name="PreviewQrDecodeLabel"
                                                   Text="已识别二维码"
                                                   FontSize="11"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ScrollViewer x:Name="PreviewQrDecodeScroll"
                                                  Margin="0,6,0,0"
                                                  MaxHeight="140"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="PreviewQrDecodeText"
                                                   Text="{Binding QrText}"
                                                   FontSize="13"
                                                   LineHeight="20"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="400" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="PreviewScroll"
                                      MaxHeight="340"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsTextual, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="PreviewBodyText"
                                       Text="{Binding HoverText}"
                                       MaxWidth="440"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="21" />
                        </ScrollViewer>
                        <!-- 悬停二维码按钮：预览切换为二维码图 -->
                        <StackPanel x:Name="PreviewQrPanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center">
                            <Image x:Name="PreviewQrImage"
                                   MaxWidth="220"
                                   MaxHeight="220"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" />
                            <TextBlock x:Name="PreviewQrCaption"
                                       Margin="0,10,0,0"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="240"
                                       Visibility="Collapsed"
                                       Text="" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>

        <!-- 二维码覆盖层 -->
        <Grid x:Name="QrOverlay"
              Grid.RowSpan="3"
              Background="#D8000000"
              Visibility="Collapsed">
            <Border Width="400"
                    Padding="28,24"
                    Background="{DynamicResource Theme.Card}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="二维码"
                               Foreground="{DynamicResource Theme.Text}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <Image x:Name="QrImage"
                           Width="300"
                           Height="300"
                           Stretch="Uniform"
                           Margin="0,14" />
                    <TextBlock x:Name="QrTextBlock"
                               MaxHeight="64"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="12"
                               TextAlignment="Center"
                               Visibility="Collapsed" />
                    <ui:Button Appearance="Primary"
                               Margin="0,14,0,0"
                               Height="36"
                               Content="关闭"
                               Click="OnCloseOverlays" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- OCR 结果覆盖层：尺寸跟主窗口走，避免比列表还宽被裁切 -->
        <Grid x:Name="OcrOverlay"
              Grid.RowSpan="3"
              Background="#D8000000"
              Visibility="Collapsed">
            <Border x:Name="OcrDialog"
                    Margin="14"
                    Padding="20,16"
                    MaxWidth="432"
                    Background="{DynamicResource Theme.Card}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="OcrTitle"
                               Text="离线识别"
                               Foreground="{DynamicResource Theme.Text}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <TextBox x:Name="OcrText"
                             Grid.Row="1"
                             MinHeight="120"
                             Margin="0,12"
                             Padding="10"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Foreground="{DynamicResource Theme.Text}"
                             Background="{DynamicResource Theme.Search}"
                             BorderBrush="{DynamicResource Theme.Border}"
                             IsReadOnly="True" />
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ui:Button Appearance="Primary"
                                   Height="36"
                                   MinWidth="120"
                                   Margin="6,0"
                                   Content="复制文字"
                                   Click="OnCopyOcrClicked" />
                        <ui:Button Appearance="Secondary"
                                   Height="36"
                                   MinWidth="120"
                                   Margin="6,0"
                                   Content="关闭"
                                   Click="OnCloseOverlays" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ui:FluentWindow>

